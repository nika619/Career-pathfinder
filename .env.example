# Career PathFinder — Environment Variables Template
# ====================================================
# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and will NEVER be pushed to GitHub.
#
# HOW THE API KEY SYSTEM WORKS:
#   Priority 1 → Judge/Tester enters their key via the UI "API Key Override" panel (session only, never stored)
#   Priority 2 → GEMINI_API_KEY in this .env file (the project owner's key)
#   Priority 3 → Deterministic fallback mode (app works 100% without any key — only AI chat/explanations are affected)
#
# ---- YOUR KEY (Primary - Owner) ----
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---- SERVER CONFIG ----
PORT=8000
HOST=0.0.0.0
